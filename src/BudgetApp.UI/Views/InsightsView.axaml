<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BudgetApp.UI.ViewModels"
             xmlns:c="using:BudgetApp.UI.Controls"
             x:Class="BudgetApp.UI.Views.InsightsView"
             x:DataType="vm:InsightsViewModel">
  <Grid>
    <ScrollViewer IsVisible="{Binding HasData}">
      <StackPanel MaxWidth="{StaticResource ContentMaxWidth}" Margin="{StaticResource PagePadding}" Spacing="{StaticResource SpaceXl}">

        <Grid ColumnDefinitions="*,Auto" Classes="reveal-0">
          <StackPanel Spacing="{StaticResource SpaceXs}">
            <TextBlock Classes="display" Text="Insights" />
            <TextBlock Classes="secondary" Text="{Binding Summary}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpaceXs}" VerticalAlignment="Center">
            <Button Classes="icon secondary" Command="{Binding PreviousMonthCommand}" ToolTip.Tip="Previous month">
              <c:IconView Key="chevron-left" />
            </Button>
            <TextBlock Classes="subtitle" Text="{Binding MonthLabel}" VerticalAlignment="Center" Margin="{StaticResource CompactPadding}" />
            <Button Classes="icon secondary" Command="{Binding NextMonthCommand}" ToolTip.Tip="Next month">
              <c:IconView Key="chevron-right" />
            </Button>
          </StackPanel>
        </Grid>

        <ItemsControl ItemsSource="{Binding Groups}" Classes="reveal-1">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="{StaticResource SpaceXl}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InsightGroup">
              <StackPanel Spacing="{StaticResource SpaceM}">
                <StackPanel Spacing="{StaticResource SpaceXs}">
                  <TextBlock Classes="title" Text="{Binding Title}" />
                  <TextBlock Classes="caption" Text="{Binding Caption}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="{StaticResource SpaceS}" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InsightItem">
                      <Border Classes="insight interactive" Classes.warning="{Binding IsWarning}" Classes.positive="{Binding IsPositive}"
                              Padding="{StaticResource CardPadding}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpaceL}">
                          <Border Classes="category-badge">
                            <c:IconView Key="{Binding Icon}" />
                          </Border>
                          <TextBlock Grid.Column="1" Classes="subtitle" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                          <Button Grid.Column="2" Classes="secondary" VerticalAlignment="Center"
                                  Content="{Binding ActionText}" IsVisible="{Binding HasAction}"
                                  Command="{Binding $parent[UserControl].((vm:InsightsViewModel)DataContext).OpenCommand}"
                                  CommandParameter="{Binding}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <c:EmptyState IsVisible="{Binding !HasData}"
                  Classes="appear"
                  Icon="sparkles"
                  Title="Insights appear once you've imported"
                  Message="Import a statement and we'll point out where your money goes, what's changed and what to watch."
                  ActionText="Import a statement"
                  Command="{Binding GoToImportCommand}" />
  </Grid>
</UserControl>
